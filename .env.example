# Copy to .env (gitignored). Any OpenAI-style chat endpoint works.
PROBE_BASE_URL=https://flash.luminal.cloud/v1
PROBE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
PROBE_API_KEY=
# Merged into every request. For DeepSeek on Luminal, hidden thinking must be off or replies get cut off.
PROBE_EXTRA_BODY={"reasoning_effort": "none"}
PROBE_MAX_TOKENS=6000
