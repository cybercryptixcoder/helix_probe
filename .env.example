# Copy to .env (gitignored). Any OpenAI-style chat endpoint works; these are the defaults.
PROBE_BASE_URL=https://flash.luminal.cloud/v1
PROBE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# One or more keys, comma-separated; calls go round-robin, each key paced at about 1 call a second.
PROBE_API_KEYS=lum_live_key1,lum_live_key2
