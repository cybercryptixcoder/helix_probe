 -12.4.\n    #    So boundary in (4.1, 4.13]. Pick 4.12. ?\n    #    Negative boundary in (-4.11, -4.105]. Pick -4.108. ?\n    #\n    # 9. Values are rounded to 1 decimal place (e.g. -12.4, 8.8, 9.8).\n    #    The special value 1548.92 is exact.\n    \n    xs = probe.get(\"x\", [])\n    ys = []\n    for x in xs:\n        if x is None:\n            ys.append(None)\n            continue\n        try:\n            xf = float(x)\n        except (TypeError, ValueError):\n            ys.append(None)\n            continue\n        \n        if xf == 0.0:\n            ys.append(1548.92)\n        elif xf > 0:\n            if xf < 4.12:\n                ys.append(-11.4)\n            else:\n                ys.append(-12.4)\n        else:  # xf < 0\n            if xf > -4.108:\n                ys.append(9.8)\n            else:\n                ys.append(8.8)\n    \n    return {\"y\": ys}\n", "notes": "The box is a piecewise-constant function with a spike at zero: `f(0) = 1548.92`; for `x > 0` it is `-11.4` up to about `4.12` then `-12.4`; for `x < 0` it is `9.8` down to about `-4.108` then `8.8`.", "since": 24, "theirs": [1.0], "ours": [1.0], "fit": 0.9958333333333332, "size": 587}